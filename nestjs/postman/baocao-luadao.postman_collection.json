{
  "info": {
    "name": "Báo cáo lừa đảo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Xác thực",
      "item": [
        {
          "name": "Đăng ký (người dân)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hoTen\": \"Nguyễn Văn A\",\n  \"email\": \"a@example.com\",\n  \"matKhau\": \"Matkhau123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json()",
                  "if (d.token) pm.collectionVariables.set('token', d.token)"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập (tự lưu token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@baocao.local\",\n  \"matKhau\": \"Admin@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json()",
                  "if (d.token) pm.collectionVariables.set('token', d.token)"
                ]
              }
            }
          ]
        },
        {
          "name": "Thông tin của tôi",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Đổi họ tên",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hoTen\": \"Nguyễn Văn B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Đổi mật khẩu (tự lưu token mới)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "change-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matKhauCu\": \"Admin@12345\",\n  \"matKhauMoi\": \"Matkhau-moi-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json()",
                  "if (d.token) pm.collectionVariables.set('token', d.token)"
                ]
              }
            }
          ]
        },
        {
          "name": "Quên mật khẩu - bước 1: gửi mã về email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"a@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Quên mật khẩu - bước 2: nhập mã + mật khẩu mới",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"a@example.com\",\n  \"ma\": \"123456\",\n  \"matKhauMoi\": \"MatkhauMoi123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Báo cáo",
      "item": [
        {
          "name": "Danh sách (lọc + phân trang)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports?status=cho_xu_ly&priority=cao&sort=soTienThietHai&dir=desc&page=1&pageSize=8&mine=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "cho_xu_ly"
                },
                {
                  "key": "priority",
                  "value": "cao"
                },
                {
                  "key": "sort",
                  "value": "soTienThietHai"
                },
                {
                  "key": "dir",
                  "value": "desc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "8"
                }
              ]
            }
          }
        },
        {
          "name": "Chi tiết báo cáo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "1"
              ]
            }
          }
        },
        {
          "name": "Tạo báo cáo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tieuDe\": \"Tuyển CTV chốt đơn yêu cầu ứng tiền\",\n  \"loai\": \"viec_lam\",\n  \"doiTuong\": \"Zalo: 0987654321\",\n  \"soTienThietHai\": 5200000,\n  \"ngayXayRa\": \"2026-10-25\",\n  \"moTa\": \"Bị yêu cầu chuyển khoản trước.\",\n  \"nguoiBaoCao\": \"Lê Văn C\"\n}"
            }
          }
        },
        {
          "name": "Cập nhật trạng thái / phân công",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trangThai\": \"dang_xac_minh\",\n  \"canBo\": \"Lê Thu Hà\",\n  \"ghiChu\": \"Đã liên hệ ngân hàng\"\n}"
            }
          }
        },
        {
          "name": "Từ chối (bắt buộc ghiChu)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trangThai\": \"tu_choi\",\n  \"ghiChu\": \"Không đủ bằng chứng\"\n}"
            }
          }
        },
        {
          "name": "Thống kê tổng quan",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stats"
              ]
            }
          }
        },
        {
          "name": "Xóa báo cáo (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Người dùng",
      "item": [
        {
          "name": "Danh sách người dùng (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users?keyword=&role=&page=1&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "Danh sách cán bộ để phân công",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/staff",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "staff"
              ]
            }
          }
        },
        {
          "name": "Tạo tài khoản (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hoTen\": \"Lê Thu Hà\",\n  \"email\": \"ha@example.com\",\n  \"matKhau\": \"Canbo12345\",\n  \"vaiTro\": \"can_bo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Đổi vai trò / khóa tài khoản (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "2"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vaiTro\": \"can_bo\",\n  \"hoatDong\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Đặt lại mật khẩu (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/2/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
